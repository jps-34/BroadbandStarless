<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>BroadbandStarless: linear RGB pipeline (ChannelCombination, GraXpert, background preview, BackgroundNeutralization, BlurXTerminator, ImageSolver, SPCC, StarXTerminator) from R, G and B masters.</p>
      <p>Add https://jps-34.github.io/BroadbandStarless/ under Resources &gt; Updates &gt; Manage Repositories.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.5:1.9.99">
      <package fileName="BroadbandStarless-1.0.4-PI195.zip" sha1="994d47467407805e13e98a7db6336d9803b98202" type="script" releaseDate="20261030" serverURL="https://jps-34.github.io/BroadbandStarless/">
         <title>BroadbandStarless 1.0.4 (PixInsight 1.9.5 and later)</title>
         <description>
            <p>Builds a linear starless RGB image and a linear star image from three R, G and B masters: ChannelCombination, GraXpert AI background extraction, automatic sky background preview, BackgroundNeutralization, BlurXTerminator (correct only), ImageSolver, SpectrophotometricColorCalibration, BlurXTerminator, StarXTerminator and optional NoiseXTerminator, then an optional auto STF. Main settings of each tool in advanced mode, source images left untouched. English or French interface. Requires the GraXpert process and the RC Astro tools. Installs under Script &gt; JPS &gt; BroadbandStarless.</p>
            <p>Copyright (c) 2026 Jacques Pouyaud. GNU GPL v3 or later. Source: https://github.com/jps-34/BroadbandStarless</p>
         </description>
      </package>
   </platform>
</xri>
